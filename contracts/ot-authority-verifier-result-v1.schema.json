{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/darklordVirtual/autonomous-ot-control/contracts/ot-authority-verifier-result-v1.schema.json",
  "title": "ot-authority-verifier-result/v1",
  "description": "Delegation verifier response. Strict scoring requires a machine-readable reason and verifier-derived delegation_id for pass/refuse. Indeterminate is separate from malformed and never a refusal or an admission.",
  "type": "object",
  "required": [
    "verdicts"
  ],
  "properties": {
    "edge_id": {
      "type": "string"
    },
    "verifier_revision": {
      "type": "string"
    },
    "verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "verdict"
        ],
        "properties": {
          "case_id": {
            "type": "string"
          },
          "verdict": {
            "enum": [
              "pass",
              "refuse",
              "indeterminate"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "delegation_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "description": "Identity extracted by the verifier from the complete supplied delegation; for APS, the leaf id. Null when identity cannot be determined. Never copied from the work order."
          }
        }
      }
    }
  }
}
